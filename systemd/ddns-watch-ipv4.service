# ddns-watch: one update run, started by ddns-watch-ipv4.timer. Catches IPv4-only changes,
# which the IPv6 watcher cannot see. Secrets: drop-in ddns-watch-ipv4.service.d/credentials.conf.
# Copyright (C) 2026 gitrys. SPDX-License-Identifier: GPL-3.0-or-later

[Unit]
Description=ddns-watch DynDNS updater (periodic IPv4 check)
Documentation=https://github.com/gitrys/ddns-watch
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/ddns-watch run
# Runs every minute or so: keep only updates, warnings and errors in the journal. This also drops
# systemd's own "Starting/Finished" lines for this unit. To see every run for a while:
# systemctl edit ddns-watch-ipv4.service  ->  [Service] LogLevelMax=debug
LogLevelMax=notice

ConfigurationDirectory=ddns-watch
StateDirectory=ddns-watch
StateDirectoryMode=0700

DynamicUser=yes
User=ddns-watch
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# "ip" (iproute2) drops its capabilities at start with capset() and fails without it. With an
# empty CapabilityBoundingSet= there is nothing to gain: capset can only drop.
SystemCallFilter=capget capset
SystemCallErrorNumber=EPERM
DevicePolicy=closed
